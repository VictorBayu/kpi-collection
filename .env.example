# Neon Postgres — Vercel > Storage > Create Database > Neon
DATABASE_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/kpi?sslmode=require"

# Vercel Blob — Vercel > Storage > Create Store > Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Kunci tanda tangan sesi. Buat dengan: openssl rand -base64 48
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Batas aman pemrosesan
IMPORT_MAX_ROWS="30000"
